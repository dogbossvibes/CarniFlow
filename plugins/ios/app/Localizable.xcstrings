            "value": "Apri piste"
          }
        }
      }
    },
    "intent.openTracks.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens your tracks in ANYVO."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet deine Fährten in ANYVO."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre tes pistes dans ANYVO."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre le tue piste in ANYVO."
          }
        }
      }
    },
    "intent.layTrack.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lay Track"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fährte legen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Poser une piste"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Posa pista"
          }
        }
