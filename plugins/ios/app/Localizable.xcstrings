            "state": "translated",
            "value": "Open Tracks"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fährten öffnen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
