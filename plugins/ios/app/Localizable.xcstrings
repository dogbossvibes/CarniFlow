    },
    "intent.layTrack.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens the screen to prepare a new track. Recording only starts when you tap Start."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet die Vorbereitung für eine neue Fährte. Die Aufnahme startet erst, wenn du auf Start tippst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre la préparation d'une nouvelle piste. L'enregistrement ne démarre que lorsque tu touches Démarrer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre la preparazione di una nuova pista. La registrazione inizia solo quando tocchi Avvia."
          }
        }
      }
    },
