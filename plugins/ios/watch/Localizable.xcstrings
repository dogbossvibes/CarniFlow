          "stringUnit": {
            "state": "translated",
            "value": "iPhone indisponible"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone non disponibile"
          }
        }
      }
    },
    "Open ANYVO on your iPhone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ANYVO auf dem iPhone öffnen."
          }
        },
