        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone verbunden"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone connecté"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone connesso"
          }
        }
      }
    },
    "iPhone unavailable": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone nicht erreichbar"
          }
        },
