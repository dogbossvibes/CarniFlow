            "state": "translated",
            "value": "Apri ANYVO sul tuo iPhone."
          }
        }
      }
    },
    "Confirmation pending. Check your iPhone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestätigung offen. Bitte am iPhone prüfen."
