{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledPlugins": {
    "expo@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Bash(git fetch *)",
      "Bash(npm test *)",
      "Bash(npm run test *)",
      "Bash(npm run test:process *)",
      "Bash(npm run typecheck *)",
      "Bash(npm run lint *)",
      "Bash(npm run agent:status *)",
      "Bash(npx jest *)",
      "Bash(npx tsc --noEmit *)",
      "Bash(eas update:list *)",
      "Bash(npx eas update:list *)",
      "Bash(eas build:list *)",
      "Bash(npx eas build:list *)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git worktree add *)",
      "Bash(npm install *)",
      "Bash(npm ci *)",
      "Bash(npx expo install *)",
      "Bash(git reset *)",
      "Bash(git clean *)",
      "Bash(npx eas update *)",
      "Bash(npx eas build *)",
      "Bash(npx eas submit *)",
      "Bash(npm run update:production *)",
      "Bash(npm run update:production:ios *)",
      "Bash(node scripts/update-production.mjs *)",
      "Bash(supabase *)",
      "Bash(npx supabase *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./google-play-service-account.json)",
      "Bash(eas update *)",
      "Bash(eas build *)",
      "Bash(eas submit *)",
      "Bash(supabase db push *)",
      "Bash(supabase db reset *)",
      "Bash(gh pr merge *)",
      "mcp__plugin_expo_expo__build_run",
      "mcp__plugin_expo_expo__build_submit",
      "mcp__plugin_expo_expo__build_cancel",
      "mcp__plugin_expo_expo__workflow_run",
      "mcp__plugin_expo_expo__workflow_cancel",
      "mcp__plugin_expo_expo__appstore_reply_review",
      "mcp__plugin_expo_expo__appstore_delete_review_response",
      "mcp__plugin_expo_expo__playstore_reply_review",
      "mcp__plugin_expo_expo__usage_budget_create",
      "Read(./.env.*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/anyvo-session-context.mjs\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit|Read",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/anyvo-guard.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/anyvo-post-edit-lint.mjs\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
