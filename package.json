{
  "name": "anyvo",
  "main": "expo-router/entry",
  "version": "1.0.1",
  "scripts": {
    "start": "expo start",
    "start:dev-client": "expo start --dev-client",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest",
    "dev": "expo start --dev-client",
    "dev:clear": "expo start --dev-client --clear",
    "ios:device": "expo run:ios --device",
    "android:device": "expo run:android --device",
    "typecheck": "tsc --noEmit",
    "doctor": "expo-doctor",
    "prebuild:check": "expo config --type introspect > /dev/null && echo 'prebuild config OK'",
    "native:check": "node ./scripts/check-native-changes.mjs",
    "check": "node ./scripts/preflight.mjs",
    "agent:status": "node scripts/agent-status.mjs",
    "agent:handoff": "node scripts/agent-handoff.mjs",
    "agent:start": "node scripts/agent-start.mjs",
    "agent:wt": "node scripts/agent-worktree.mjs",
    "agent:wt:create": "node scripts/agent-worktree.mjs create",
    "agent:wt:list": "node scripts/agent-worktree.mjs list",
    "agent:wt:finish": "node scripts/agent-worktree.mjs finish",
    "agent:wt:remove": "node scripts/agent-worktree.mjs remove",
    "build:local:ios:dev": "eas build --profile development --platform ios --local",
    "build:local:android:dev": "eas build --profile development --platform android --local",
    "update:development": "eas update --channel development --message",
    "update:preview": "eas update --channel preview --message",
    "update:production": "node ./scripts/update-production.mjs",
    "update:production:ios": "node ./scripts/update-production.mjs --platform ios --confirm",
    "guard:prod-supabase": "node ./scripts/guard-prod-supabase.mjs",
    "build:dev:ios": "eas build --profile development --platform ios",
    "build:dev:ios:sim": "eas build --profile development-simulator --platform ios",
    "build:dev:android": "eas build --profile development --platform android",
    "build:prod:ios": "eas build --profile production --platform ios",
    "build:prod:android": "eas build --profile production --platform android",
    "postinstall": "node scripts/patch-expo-task-manager.cjs && node scripts/patch-react-native-maps.cjs",
    "eas-build-post-install": "node scripts/native-map-crash-check.mjs"
  },
  "jest": {
    "preset": "jest-expo",
    "resolver": "react-native-reanimated/jest/resolver.js",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    },
    "testMatch": [
      "**/__tests__/**/*.test.ts?(x)"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.cjs"
    ]
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@expo/vector-icons": "^15.0.3",
    "@pdf-lib/fontkit": "1.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-community/netinfo": "12.0.1",
    "@sentry/react-native": "~8.28.0",
    "@supabase/supabase-js": "^2.106.2",
    "@tanstack/react-query": "^5.100.14",
    "expo": "^58.0.23",
    "expo-apple-authentication": "~58.0.2",
    "expo-application": "~58.1.2",
    "expo-asset": "~58.0.20",
    "expo-audio": "~58.0.11",
    "expo-auth-session": "~58.0.17",
    "expo-blur": "~58.0.5",
    "expo-build-properties": "~58.0.12",
    "expo-calendar": "~58.0.6",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.15",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.18",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-keep-awake": "~58.0.3",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.16",
    "expo-live-activity": "^0.4.2",
    "expo-local-authentication": "~58.0.2",
    "expo-localization": "~58.0.5",
    "expo-location": "~58.0.20",
    "expo-notifications": "~58.1.8",
    "expo-router": "~58.0.30",
    "expo-sensors": "~58.0.4",
    "expo-sharing": "~58.0.22",
    "expo-speech": "~58.0.3",
    "expo-speech-recognition": "^58.0.1",
    "expo-splash-screen": "~58.0.13",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-task-manager": "~58.0.13",
    "expo-updates": "~58.0.21",
    "expo-video": "~58.0.13",
    "expo-video-thumbnails": "~58.0.2",
    "expo-web-browser": "~58.0.7",
    "i18next": "^26.3.6",
    "jest-expo": "~58.0.14",
    "nativewind": "^4.2.4",
    "pdf-lib": "1.17.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.0.9",
    "react-native": "0.88.1",
    "react-native-ble-plx": "^3.5.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-maps": "1.29.11",
    "react-native-purchases": "^10.16.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-volume-manager": "^2.0.8",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.88.1",
    "@types/jest": "30.0.0",
    "@types/node": "^25.9.1",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "react-test-renderer": "^19.3.0",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3"
  },
  "private": true
}
